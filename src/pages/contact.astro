---
import Layout from "../layouts/Layout.astro";

// Base64-encoded so the address never sits as plain scrapable text in the
// page source; a small inline script decodes it and builds the mailto link
// client-side.
const encodedEmail = "eWVudGh1Yy50cmFuMTEyQGdtYWlsLmNvbQ==";
---

<Layout title="Contact — Melody Tran" description="Get in touch with Melody Tran.">
  <main>
    <p class="lead">Get in touch.</p>
    <p>
      Have a project, a role, or just want to talk about design? I'd love to
      hear from you.
    </p>

    <button type="button" class="email-button" data-email={encodedEmail} disabled>
      Say hello
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 16L16 4M16 4H7M16 4V13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <noscript>
      <p class="fallback">Enable JavaScript to reveal a contact link, or reach out via LinkedIn.</p>
    </noscript>
  </main>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>(".email-button");
  if (button) {
    const encoded = button.dataset.email ?? "";
    const email = atob(encoded);
    button.disabled = false;
    button.addEventListener("click", () => {
      window.location.href = `mailto:${email}`;
    });
  }
</script>

<style>
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .lead {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  p {
    font-size: 1rem;
    line-height: 1.65;
    max-width: 55ch;
  }

  .email-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    align-self: flex-start;
    margin-top: var(--space-2);
    padding: 0.75em 1.4em;
    font-size: 1rem;
    background: var(--fg);
    color: var(--bg);
    border-radius: 4px;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease),
      opacity var(--duration-fast) var(--ease);
  }

  .email-button:hover {
    transform: translateY(-2px);
    opacity: 0.85;
  }

  .email-button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .fallback {
    color: var(--muted);
  }

  @media (max-width: 600px) {
    main {
      padding: var(--space-4) var(--space-2) var(--space-5);
    }
  }
</style>
