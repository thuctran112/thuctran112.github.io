---
import Layout from "../layouts/Layout.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import { getCollection } from "astro:content";

const caseStudies = (await getCollection("caseStudies")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Melody Tran — Product Designer">
  <main>
    <section class="grid" aria-label="Case studies">
      {
        caseStudies.map((study) => (
          <CaseStudyCard
            slug={study.id}
            title={study.data.title}
            summary={study.data.summary}
            timeframe={study.data.timeframe}
            platform={study.data.platform}
            isProtected={study.data.protected}
            company={study.data.company}
            logo={study.data.logo}
            accent={study.data.accent}
            cover={study.data.cover}
            metadata={study.data.metadata}
          />
        ))
      }
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--space-3) var(--space-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  function initCardHover() {
    const grid = document.querySelector('.grid');
    if (!grid) return;

    const cardWrappers = grid.querySelectorAll('.card-wrapper');

    cardWrappers.forEach((wrapper) => {
      wrapper.addEventListener('mouseenter', () => {
        cardWrappers.forEach((w) => {
          if (w !== wrapper) {
            w.style.opacity = '0.4';
            w.style.filter = 'grayscale(100%)';
            w.style.transition = 'all 0.3s ease';
          }
        });
      });

      wrapper.addEventListener('mouseleave', () => {
        cardWrappers.forEach((w) => {
          w.style.opacity = '';
          w.style.filter = '';
          w.style.transition = '';
        });
      });
    });
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCardHover);
  } else {
    initCardHover();
  }
</script>
