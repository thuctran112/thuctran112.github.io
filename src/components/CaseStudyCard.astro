---
interface Props {
  slug: string;
  title: string;
  summary: string;
  timeframe: string;
  platform: string;
  isProtected: boolean;
  company: string;
  logo: string;
  accent: string;
  cover: string;
}

const {
  slug,
  title,
  summary,
  timeframe,
  platform,
  isProtected,
  company,
  logo,
  accent,
  cover,
} = Astro.props;
---

<div class="card-wrapper">
  <a class="card" href={`/work/${slug}/`} style={`--card-accent: ${accent}`}>
    <div class="card-image-container">
      <img class="card-cover" src={`/covers/${cover}`} alt={title} />
    </div>
    <div class="card-content">
      <div class="card-header">
        {isProtected && <span class="lock-icon">🔒</span>}
        <span class="company-name">{company}</span>
      </div>
      <h3 class="project-title">{title}</h3>
      <p class="project-summary">{summary}</p>
    </div>
  </a>
</div>

<style>
  .card-wrapper {
    display: flex;
    flex-direction: column;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 2px solid var(--card-accent);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg);
    transition:
      transform var(--duration-med) var(--ease),
      box-shadow var(--duration-med) var(--ease);
    will-change: transform;
    text-decoration: none;
    color: inherit;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-8px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
  }

  .card:focus-visible {
    outline: 2px solid var(--card-accent);
    outline-offset: 2px;
  }

  .card-image-container {
    overflow: hidden;
    background: var(--surface-1);
  }

  .card-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.8;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .card:hover .card-cover {
    transform: scale(1.03);
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lock-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .company-name {
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.5px;
  }

  .project-title {
    color: var(--fg);
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.3;
    margin: 0;
  }

  .project-summary {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:focus-visible {
      transform: none;
    }
  }
</style>
