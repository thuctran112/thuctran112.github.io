---
interface Props {
  slug: string;
  title: string;
  summary: string;
  timeframe: string;
  platform: string;
  isProtected: boolean;
  company: string;
  logo: string;
  accent: string;
  cover: string;
  metadata?: string;
}

const {
  slug,
  title,
  summary,
  timeframe,
  platform,
  isProtected,
  company,
  logo,
  accent,
  cover,
  metadata,
} = Astro.props;
---

<div class="card-wrapper">
  <a class="card" href={`/work/${slug}/`} style={`--card-accent: ${accent}`}>
    <div class="card-image-container">
      <img class="card-cover" src={`/covers/${cover}`} alt={title} />
    </div>
  </a>
  <div class="card-title-row">
    {isProtected && <span class="lock-icon">🔒</span>}
    <span class="title-text">
      <span class="company-name">{company}</span>
      <span class="separator"> • </span>
      <span class="project-title">{title}</span>
    </span>
    <span class="card-arrow">→</span>
  </div>
  {metadata && <div class="card-metadata">{metadata}</div>}
</div>

<style>
  .card-wrapper {
    display: flex;
    flex-direction: column;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg);
    transition:
      transform var(--duration-med) var(--ease),
      border-color var(--duration-med) var(--ease),
      box-shadow var(--duration-med) var(--ease);
    will-change: transform;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-6px);
    border-color: var(--border-strong);
    box-shadow: 0 12px 24px -16px rgba(0, 0, 0, 0.35);
  }

  .card:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  .card-image-container {
    overflow: hidden;
  }

  .card-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.6;
    object-fit: cover;
  }

  .card-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    justify-content: space-between;
  }

  .lock-icon {
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .title-text {
    display: flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.9375rem;
    line-height: 1.4;
    flex: 1;
  }

  .company-name {
    font-weight: 600;
    color: var(--fg);
  }

  .separator {
    color: var(--muted);
    font-weight: 400;
  }

  .project-title {
    color: var(--fg);
    font-weight: 400;
  }

  .card-arrow {
    font-size: 0.9375rem;
    color: var(--muted);
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.3s ease;
  }

  .card-wrapper:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--fg);
  }

  .card-metadata {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.4;
    padding: 0 0 0.25rem 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card-wrapper:hover .card-metadata {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:focus-visible {
      transform: none;
    }
  }
</style>
