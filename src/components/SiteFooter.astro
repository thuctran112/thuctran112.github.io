<footer class="site-footer">
  <div class="footer-left">
    <p>© Melody Tran, 2026</p>
  </div>
  <nav aria-label="Footer" class="footer-nav">
    <a href="https://www.linkedin.com/in/melody112/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a href="/resume/">Resume</a>
  </nav>
</footer>

<style>
  .site-footer {
    max-width: 100%;
    margin: 0 auto;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .footer-left {
    display: flex;
    align-items: center;
  }

  .footer-left p {
    font-size: 0.9375rem;
    color: var(--muted);
    margin: 0;
  }

  .footer-nav {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .footer-nav a {
    font-size: 0.9375rem;
    color: var(--muted);
    transition: color var(--duration-fast) var(--ease);
  }

  .footer-nav a:hover {
    color: var(--fg);
  }

  @media (max-width: 600px) {
    .site-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .footer-nav {
      width: 100%;
      gap: 1rem;
    }
  }
</style>
