---
// Client-side password protection component
---

<div id="password-gate" class="password-gate">
  <div class="password-container">
    <h1>Access Case Study</h1>
    <p>Enter the password to view this case study</p>
    <form id="password-form">
      <input
        type="password"
        id="password-input"
        placeholder="Enter password"
        required
      />
      <button type="submit">Unlock</button>
    </form>
    <p id="error-message" class="error" style="display:none;">Incorrect password</p>
  </div>
</div>

<div id="content" style="display:none;">
  <slot />
</div>

<style>
  .password-gate {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: auto;
    padding: 2rem 0;
    background: #ffffff;
  }

  .password-container {
    background: #ffffff;
    padding: 1.5rem;
    border-radius: 0;
    box-shadow: none;
    text-align: center;
    max-width: 360px;
    width: 90%;
  }

  h1 {
    margin: 0 0 0.375rem 0;
    font-size: 1.75rem;
    font-weight: 600;
    color: #000;
    letter-spacing: -0.02em;
  }

  p {
    color: #666;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  input {
    width: 100%;
    padding: 0.875rem 0;
    border: none;
    border-bottom: 1px solid #e5e5e5;
    border-radius: 0;
    font-size: 1rem;
    background: transparent;
    font-family: inherit;
  }

  input:focus {
    outline: none;
    border-bottom-color: #000;
  }

  input::placeholder {
    color: #999;
  }

  button {
    padding: 0.875rem;
    background: #000;
    color: white;
    border: none;
    border-radius: 0;
    font-size: 0.95rem;
    cursor: pointer;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-top: 0.5rem;
    transition: opacity 0.2s ease;
  }

  button:hover {
    opacity: 0.8;
  }

  .error {
    color: #dc3545;
    margin-top: 1rem;
    font-size: 0.9rem;
  }
</style>

<script define:vars={{ password: "melody123" }}>
  const passwordForm = document.getElementById("password-form");
  const passwordInput = document.getElementById("password-input");
  const errorMessage = document.getElementById("error-message");
  const passwordGate = document.getElementById("password-gate");
  const content = document.getElementById("content");
  const caseStudyId = window.location.pathname;

  // Check if password is already stored
  if (localStorage.getItem(`case-study-${caseStudyId}`)) {
    passwordGate.style.display = "none";
    content.style.display = "block";
  }

  passwordForm.addEventListener("submit", (e) => {
    e.preventDefault();
    if (passwordInput.value === password) {
      localStorage.setItem(`case-study-${caseStudyId}`, "true");
      passwordGate.style.display = "none";
      content.style.display = "block";
    } else {
      errorMessage.style.display = "block";
      passwordInput.value = "";
    }
  });
</script>
