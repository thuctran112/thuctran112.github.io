---
interface Props {
  before: string;
  after: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const { before, after, beforeLabel = "Before", afterLabel = "After" } = Astro.props;
---

<div class="before-after">
  <div class="before-after-container">
    <img src={before} alt={beforeLabel} class="before-img" />
    <div class="slider"></div>
    <img src={after} alt={afterLabel} class="after-img" />
    <div class="labels">
      <span class="label-before">{beforeLabel}</span>
      <span class="label-after">{afterLabel}</span>
    </div>
  </div>
</div>

<style>
  .before-after {
    width: 100%;
    max-width: 600px;
    margin: 2rem 0;
  }

  .before-after-container {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  .before-img {
    position: absolute;
    top: 0;
    left: 0;
  }

  .after-img {
    width: 100%;
  }

  .slider {
    position: absolute;
    top: 0;
    left: 50%;
    width: 4px;
    height: 100%;
    background: white;
    cursor: col-resize;
    transform: translateX(-50%);
    z-index: 10;

    &::before,
    &::after {
      content: "";
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 40px;
      height: 40px;
      background: white;
      border-radius: 50%;
    }

    &::before {
      left: -50%;
      clip-path: polygon(0 0, 50% 0, 50% 100%, 0 100%);
    }

    &::after {
      right: -50%;
      clip-path: polygon(50% 0, 100% 0, 100% 100%, 50% 100%);
    }
  }

  .labels {
    position: absolute;
    bottom: 1rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    padding: 0 1rem;
    pointer-events: none;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .label-before {
    color: white;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .label-after {
    color: white;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
</style>

<script>
  const container = document.querySelector(".before-after-container") as HTMLElement;
  const beforeImg = document.querySelector(".before-img") as HTMLImageElement;
  const slider = document.querySelector(".slider") as HTMLElement;

  if (container && slider && beforeImg) {
    const handleMove = (e: MouseEvent | TouchEvent) => {
      const rect = container.getBoundingClientRect();
      const clientX = e instanceof TouchEvent ? e.touches[0].clientX : e.clientX;
      const x = Math.max(0, Math.min(clientX - rect.left, rect.width));
      const percent = (x / rect.width) * 100;

      slider.style.left = percent + "%";
      beforeImg.style.width = percent + "%";
    };

    const handleEnd = () => {
      document.removeEventListener("mousemove", handleMove);
      document.removeEventListener("touchmove", handleMove);
      document.removeEventListener("mouseup", handleEnd);
      document.removeEventListener("touchend", handleEnd);
    };

    slider.addEventListener("mousedown", () => {
      document.addEventListener("mousemove", handleMove);
      document.addEventListener("mouseup", handleEnd);
    });

    slider.addEventListener("touchstart", () => {
      document.addEventListener("touchmove", handleMove);
      document.addEventListener("touchend", handleEnd);
    });
  }
</script>
