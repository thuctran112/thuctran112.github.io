---
interface Props {
  title: string;
  error?: string;
}

const { title, error } = Astro.props;
---

<section class="gate">
  <span class="eyebrow">Protected case study</span>
  <h1>{title}</h1>
  <p class="copy">This project is under NDA. Enter the password to view it.</p>

  <form method="POST" class="form">
    <label class="visually-hidden" for="password">Password</label>
    <input
      id="password"
      name="password"
      type="password"
      autocomplete="off"
      required
      aria-invalid={error ? "true" : undefined}
    />
    <button type="submit">Unlock</button>
  </form>

  {error && <p class="error" role="alert">{error}</p>}
</section>

<style>
  .gate {
    max-width: 34rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .copy {
    color: var(--muted);
    max-width: 40ch;
  }

  .form {
    display: flex;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  input {
    flex: 1;
    font: inherit;
    font-size: 1rem;
    padding: 0.65em 0.85em;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
  }

  input:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  button {
    font-size: 1rem;
    padding: 0.65em 1.25em;
    background: var(--fg);
    color: var(--bg);
    border-radius: 4px;
    transition: opacity var(--duration-fast) var(--ease);
  }

  button:hover {
    opacity: 0.85;
  }

  .error {
    color: var(--fg);
    font-size: 0.9rem;
    border-left: 2px solid var(--border-strong);
    padding-left: var(--space-1);
  }
</style>
