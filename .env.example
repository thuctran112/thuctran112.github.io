# Secret used to sign the auth cookie for protected case studies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Per-case-study passwords. Env var name is derived from the content
# slug (src/content/case-studies/<slug>.md): dashes -> underscores, upper-cased,
# prefixed with CASE_STUDY_PASSWORD_.
CASE_STUDY_PASSWORD_MASTERCARD_COLOR_SYSTEM=
CASE_STUDY_PASSWORD_EUROCTP_WEBSITE=
CASE_STUDY_PASSWORD_INTERMODAL_TRACKING=
